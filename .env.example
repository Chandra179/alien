# Backend: "mock" (offline), "hf" (HuggingFace), "openrouter", "opencode-go", or "modal"
# HF_BACKEND=mock

# HuggingFace API token (required when HF_BACKEND=hf)
HF_TOKEN=your_huggingface_token_here
# HuggingFace model (optional, default from config.yaml: google/gemma-4-31b-it)
# HF_MODEL=google/gemma-4-31b-it

# OpenRouter API key (required when HF_BACKEND=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# OpenRouter model (optional, default from config.yaml: google/gemma-4-31b-it)
# OPENROUTER_MODEL=google/gemma-4-31b-it

# OpenCode Go API key (required when HF_BACKEND=opencode-go)
# OPENCODE_GO_API_KEY=sk-opencode-your_gokey_here
# OpenCode Go model (optional, default from config.yaml: mimo-v2.5)
# OPENCODE_GO_MODEL=mimo-v2.5

# Modal (vLLM on GPU cloud) — deploy with:
#   uv run modal deploy src/alien_obfuscator/modal_serve.py
# Then set the URL printed by the deploy command.
HF_BACKEND=modal
MODAL_API_URL=https://your-workspace--modal-gemma-serve.modal.run
MODAL_MODEL=google/gemma-4-31b-it
